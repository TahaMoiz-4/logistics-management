# Copy to .env and fill in. .env is gitignored and excluded from Docker images
# (.dockerignore) - it is read from the host at container start instead.
#
# Only the settings you actually need to vary per deployment are listed here.
# Everything else (solver penalties, fuel prices, pooling, tracking windows)
# has a default in src/core/config.py and is better tuned there or per-run via
# RoutePlan.optimization_params.

# ── Postgres ─────────────────────────────────────────────────────────────────
# Local dev (./start.sh): host port 5433, mapped from the container's 5432.
# Under docker compose this value is IGNORED - the backend service sets
# DATABASE_URL to postgresql://user:password@postgres:5432/LMS, and real env
# vars outrank the env_file in pydantic-settings.
DATABASE_URL=postgresql://user:password@localhost:5433/LMS

# Print every SQL statement. Useful locally, noisy in a deployment.
DB_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────────────
# Also overridden to redis://redis:6379/0 by compose.
REDIS_URL=redis://localhost:6379/0

# ── App ──────────────────────────────────────────────────────────────────────
# development | production
APP_ENV=development

# Signs auth tokens. Generate a fresh one per deployment - never reuse the
# default or share it between environments:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Browser origins allowed to call the API (comma-separated).
# Behind nginx the console is same-origin and needs no entry here; this is for
# anything served from a different origin (local Vite dev, a separate host).
# On the VM this is the external IP *including the port*, e.g.
#   CORS_ORIGINS=http://34.16.22.101:8030
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host port the console is published on (nginx -> :80 inside the container).
# Defaults to 8030 if unset. Set it explicitly on a shared box where other
# services already hold ports - check with: sudo ss -tlnp | grep ':80'
WEB_PORT=8030

# ── Firebase Cloud Messaging ─────────────────────────────────────────────────
# Push notifications run in STUB mode (log intent, send nothing) unless BOTH are
# set - see src/services/notifications/fcm.py.
#
# The JSON is a live credential: keep it in src/secrets/ (gitignored, and
# .dockerignore keeps it out of images). Compose mounts that directory read-only
# at /run/secrets/firebase/ and sets this path accordingly, so the deployed
# value differs from the local one.
FIREBASE_CREDENTIALS_PATH=src/secrets/your-firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-firebase-project-id
